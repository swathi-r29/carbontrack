				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set(\"authToken\", jsonData.accessToken);",
									"    pm.test(\"Token successfully set in authToken variable\", function () {",
									"        pm.expect(pm.collectionVariables.get(\"authToken\")).to.not.be.undefined;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
