# Production Environment
# These settings are used when deployed to production

VITE_API_BASE_URL=https://carbontrack-backend-d060.onrender.com
VITE_API_TIMEOUT=15000
VITE_ENV=production

VITE_USE_MOCK_DATA=false
VITE_DEBUG_API=false
